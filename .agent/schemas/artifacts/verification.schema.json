{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awf.verification.v1",
  "title": "AWF Verification Artifact",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "commands",
    "manual_checks",
    "known_failures"
  ],
  "properties": {
    "schema": { "const": "awf.verification.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "status", "summary"],
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass"] },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "manual_checks": { "type": "array" },
    "known_failures": { "type": "array" }
  },
  "additionalProperties": true
}
