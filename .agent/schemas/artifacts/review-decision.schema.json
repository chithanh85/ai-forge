{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awf.review-decision.v1",
  "title": "AWF Review Decision Artifact",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "reviewer",
    "decision",
    "reviewers",
    "findings",
    "required_followups"
  ],
  "properties": {
    "schema": { "const": "awf.review-decision.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["APPROVE", "APPROVED", "PASS", "REQUEST_CHANGES", "BLOCK"]
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "decision", "score", "findings"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": ["APPROVE", "APPROVED", "PASS", "REQUEST_CHANGES", "BLOCK"]
          },
          "score": { "type": "number", "minimum": 0, "maximum": 5 },
          "findings": { "type": "array" }
        },
        "additionalProperties": true
      }
    },
    "findings": { "type": "array" },
    "required_followups": { "type": "array" }
  },
  "additionalProperties": true
}
