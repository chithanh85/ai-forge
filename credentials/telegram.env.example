# Teleport — Telegram Bot Config
# ================================
# Copy this to ../teleport/.env (sibling of your project root)
# NEVER commit the real .env to Git!
#
# Setup steps:
#   1. Create bot: Telegram → @BotFather → /newbot → copy token
#   2. Get your Chat ID: Telegram → @userinfobot → Start → copy ID
#   3. (Group) Add bot + @RawDataBot to group → copy group ID (negative)
#   4. cp credentials/telegram.env.example ../teleport/.env
#   5. Edit ../teleport/.env and fill in real values
#   6. Test: node ../teleport/scripts/send-telegram.mjs "hello"
#
# Usage (in any AI session):
#   "tele me" / "gửi tele" / "ping me when done"

REPORT_BOT_TOKEN=               # e.g. 8782121519:AAEbyLui...
TELEGRAM_ADMIN_CHAT_ID=         # e.g. 375801908 (personal) or -100123456 (group)
