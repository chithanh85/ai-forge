# SSH Config Template — Copy to ~/.ssh/config
# Enables AI to SSH into servers without password prompts

Host production
    HostName <PRODUCTION_IP>
    User deploy
    IdentityFile ~/.ssh/id_ed25519
    StrictHostKeyChecking accept-new
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host staging
    HostName <STAGING_IP>
    User deploy
    IdentityFile ~/.ssh/id_ed25519
    StrictHostKeyChecking accept-new

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
