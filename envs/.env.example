# ============================================================
# Environment Variables — Master Template
# ============================================================
# Copy this file: cp envs/.env.example .env
# Then fill in your values.
# ============================================================

# ─── APP ─────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=my-app
APP_PORT=3000
APP_URL=http://localhost:3000

# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp

# ─── AUTH ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── REDIS (optional) ───────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── EXTERNAL SERVICES ──────────────────────────────────────
# SENTRY_DSN=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
